{
  "version": "2.3.0",
  "mode": "paper_research",
  "universe": ["EUR/USD", "GBP/USD", "USD/JPY"],
  "timeframes": {"macro": "H1", "structure": "M15", "execution": "M5"},
  "baseline": {
    "proposal_source": "volatility_band_breakout_or_mean_reversion",
    "probability_threshold": 0.55,
    "frozen_rf": {
      "trees": 500,
      "max_depth": 7,
      "min_samples_split": 50,
      "min_samples_leaf": 25,
      "seed": 42,
      "criterion": "entropy",
      "class_weight": "balanced"
    },
    "triple_barrier": {
      "upper_vol_multiplier": 1.5,
      "lower_vol_multiplier": 1.0,
      "expiry_bars": 24
    }
  },
  "risk": {
    "half_kelly_max_account_risk": 0.015,
    "max_leverage": 10.0,
    "daily_drawdown_limit": 0.025,
    "spread_multiplier": 3.0,
    "turnover_target": 0.004
  },
  "modules": {
    "AB": {"state": "shadow"},
    "AC": {"state": "shadow"},
    "AD": {"state": "shadow"},
    "AE": {"state": "shadow"},
    "AF": {"state": "shadow"},
    "AG": {"state": "shadow"},
    "AH": {"state": "shadow"},
    "AI": {"state": "shadow"}
  },
  "live_orders": false
}
